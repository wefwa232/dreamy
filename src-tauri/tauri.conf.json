{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreamy",
  "version": "0.1.1",
  "identifier": "com.dreamy.journal",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dreamy",
        "width": 640,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NTA3QjNCRTFBNEM3QUUKUldTdXg2VGhPM3RRK2ZhTXl0RzlQdEJqQUZTZENSSU9nR0lOSXczZVVmNXoyR25MZ1RrTkVyVDMK",
      "endpoints": [
        "https://github.com/wefwa232/dreamy/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
